      "namespace_id": "1002",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "PRACTICE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "NICK_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DEMO_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "REVIEW_LIMITER",
      "namespace_id": "1006",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "env": {
    "liber": {
      "vars": {
